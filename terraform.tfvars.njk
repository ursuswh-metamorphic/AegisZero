# =============================================================================
# AEGIS PORTAL – DỮ LIỆU ĐẦU VÀO ĐƯỢC GENERATE TỰ ĐỘNG (HYBRID)
# =============================================================================

project_name       = "{{ project_name }}"
environment        = "{{ environment }}"

# ── AWS Parameters ───────────────────────────────────────────────────────────
aws_vpc_cidr       = "{{ aws_vpc_cidr }}"
aws_subnet_cidr    = "{{ aws_subnet_cidr }}"
aws_instance_type  = "{{ aws_instance_type }}"
aws_ebs_size       = {{ aws_ebs_size }}
aws_ebs_encrypted  = {{ aws_ebs_encrypted | lower }}
aws_iam_admin_role = {{ aws_iam_admin_role | lower }}
aws_inbound_ports  = [{{ aws_inbound_ports | join(',') }}]

# ── OpenStack Parameters ──────────────────────────────────────────────────────
os_network_name    = "{{ os_network_name }}"
os_subnet_cidr     = "{{ os_subnet_cidr }}"
os_db_port         = {{ os_db_port }}
os_db_allowed_cidr = "{{ os_db_allowed_cidr }}"
os_flavor_name     = "{{ os_flavor_name }}"